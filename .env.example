# Local persistence. Never point this at the preview database.
FAIR_DB_PATH=.local-data/fair-reminders.sqlite
FAIR_EVENT_NAME=veletrh
FAIR_ORIGIN=http://localhost:3000

# Required in production. The local fallback uses REGISTRATIONS_SESSION_SECRET from preview.
FAIR_IP_HASH_SECRET=
FAIR_ADMIN_KEY_HASH=
FAIR_ADMIN_SESSION_SECRET=

# Server-to-server copy into zhotoveno-web PostgreSQL.
FAIR_POSTGRES_SYNC_URL=http://localhost:3000/api/internal/b2b/fair-preregistrations
# Shared random secret, at least 32 bytes.
FAIR_POSTGRES_SYNC_TOKEN=

# Local development only. Do not set this in production.
ZHOTOVENO_MOCK_EMAILS=1

# Required for actual delivery in production. Switch without changing callers.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_SENDER_EMAIL=
RESEND_SENDER_NAME=
RESEND_REPLY_TO_EMAIL=
RESEND_REPLY_TO_NAME=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_REPLY_TO_EMAIL=
BREVO_REPLY_TO_NAME=

# Destinations shown in the registration reminder e-mail.
NEXT_PUBLIC_ZHOTOVENO_WEB_URL=https://b2b.zhotoveno.cz
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/id6797518819
NEXT_PUBLIC_GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=cz.zhotoveno.zhotoveno
NEXT_PUBLIC_PRIVACY_URL=https://veletrh.zhotoveno.cz/ochrana-soukromi
